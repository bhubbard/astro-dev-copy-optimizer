{
  "name": "astro-dev-copy-optimizer",
  "version": "0.1.0",
  "description": "Astro Dev Toolbar app to inspect on-page text and rewrite copy with Chrome Built-in AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./src/app.ts",
      "import": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "dev-toolbar",
    "chrome-ai",
    "window.ai",
    "copywriting",
    "llm",
    "prompt-api"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "bun build src/index.ts --outdir ./dist --target node --external astro && bun build src/app.ts --outdir ./dist --target browser --external astro/toolbar",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  }
}
